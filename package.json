{
  "name": "circle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed-admin": "npx tsx scripts/seed-admin.ts",
    "migrate:uploads": "npx tsx scripts/migrate-uploads-to-s3.ts",
    "optimize:listings": "node scripts/optimize-stock-listings.mjs",
    "optimize:uploads": "node scripts/optimize-uploads.mjs",
    "apk:sync": "npx cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "apk": "npm run apk:sync && npm run apk:debug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@prisma/client": "^6.19.0",
    "jalaali-js": "^2.0.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "use-context-selector": "^2.0.0",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5"
  }
}
