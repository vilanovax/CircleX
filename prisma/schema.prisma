generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrustGroup {
  A
  B
  C
}

enum RelationType {
  family
  friend
  colleague
  neighbor
  acquaintance
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum InviteKind {
  personal
  wave
}

enum JoinRequestStatus {
  pending
  accepted
  rejected
}

model User {
  id                 String    @id @default(cuid())
  phoneNormalized    String    @unique
  name               String    @default("")
  avatar             String    @default("")
  city               String?
  profileCompletedAt     DateTime?
  showOwnListingsInFeed  Boolean   @default(true)
  bannedAt           DateTime?
  bannedUntil        DateTime?
  banReason          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions        Session[]
  otpChallenges   OtpChallenge[]
  invitesSent        Invite[]           @relation("Inviter")
  invitesAccepted    Invite[]           @relation("AcceptedBy")
  inviteAcceptances  InviteAcceptance[]
  inviteExpected     InviteExpected[]
  edgesFrom          CircleEdge[]       @relation("EdgeFrom")
  edgesTo            CircleEdge[]       @relation("EdgeTo")
  listings            MarketListing[]
  listingReports      ListingReport[]
  listingEndorsements ListingEndorsement[]
  joinRequestsHost    CircleJoinRequest[]  @relation("JoinHost")
  joinRequestsGuest   CircleJoinRequest[]  @relation("JoinGuest")
  messagesSent        DirectMessage[]      @relation("MessageFrom")
  messagesReceived    DirectMessage[]      @relation("MessageTo")
  wantRequests        WantRequest[]        @relation("WantRequester")
  wantOffers          WantOffer[]          @relation("WantOfferer")
  gatheringsHosted    Gathering[]          @relation("GatheringHost")
  gatheringRsvps      GatheringRsvp[]
  savedListings       SavedListing[]
  threadPrefs         ThreadPreference[]   @relation("ThreadOwner")
  threadAsPeer        ThreadPreference[]   @relation("ThreadPeer")
  systemNotices       SystemNotice[]
  listingWatches      ListingWatch[]       @relation("WatchOwner")
  watchedBy           ListingWatch[]       @relation("WatchTarget")

  @@index([phoneNormalized])
  @@index([bannedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpChallenge {
  id              String   @id @default(cuid())
  phoneNormalized String
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNormalized])
}

model Invite {
  id               String       @id @default(cuid())
  code             String       @unique
  inviterUserId    String
  inviter          User         @relation("Inviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitedPhone     String?
  invitedName      String?
  relationType     RelationType
  trustGroup       TrustGroup
  kind             InviteKind   @default(personal)
  maxUses          Int          @default(1)
  useCount         Int          @default(0)
  status           InviteStatus @default(pending)
  acceptedByUserId String?
  acceptedBy       User?        @relation("AcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  acceptances      InviteAcceptance[]
  expected         InviteExpected[]
  joinRequests     CircleJoinRequest[]

  @@index([inviterUserId, status])
  @@index([invitedPhone])
}

model InviteExpected {
  id           String   @id @default(cuid())
  inviteId     String
  phone        String
  name         String?
  joinedUserId String?
  createdAt    DateTime @default(now())
  invite       Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  joinedUser   User?    @relation(fields: [joinedUserId], references: [id], onDelete: SetNull)

  @@unique([inviteId, phone])
  @@index([inviteId])
  @@index([phone])
}

model InviteAcceptance {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String
  createdAt DateTime @default(now())
  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([inviteId])
  @@index([userId])
}

model CircleJoinRequest {
  id          String            @id @default(cuid())
  hostUserId  String
  guestUserId String
  inviteId    String?
  status      JoinRequestStatus @default(pending)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  host   User    @relation("JoinHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  guest  User    @relation("JoinGuest", fields: [guestUserId], references: [id], onDelete: Cascade)
  invite Invite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@unique([hostUserId, guestUserId])
  @@index([hostUserId, status])
  @@index([guestUserId])
  @@index([inviteId])
}

model CircleEdge {
  id           String       @id @default(cuid())
  fromUserId   String
  toUserId     String
  trustGroup   TrustGroup
  relationType RelationType
  displayName  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  from         User         @relation("EdgeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to           User         @relation("EdgeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model MarketListing {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        String
  price       Int?
  category    String
  image       String
  images      String[] @default([])
  condition   String?
  privacy     String   @default("ABC")
  city        String?
  area        String?
  specs       Json?
  dealStatus  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reports      ListingReport[]
  messages     DirectMessage[]
  endorsements ListingEndorsement[]
  saves        SavedListing[]

  @@index([sellerId])
}

model ListingEndorsement {
  id        String   @id @default(cuid())
  listingId String
  listing   MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  personId  String
  person    User          @relation(fields: [personId], references: [id], onDelete: Cascade)
  types     String[]
  note      String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, personId])
  @@index([listingId])
  @@index([personId])
}

enum ListingReportReason {
  inappropriate
  misleading
  spam
  other
}

enum ListingReportStatus {
  open
  reviewed
  dismissed
}

model ListingReport {
  id         String              @id @default(cuid())
  listingId  String
  listing    MarketListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ListingReportReason
  note       String?
  status     ListingReportStatus @default(open)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
  @@index([listingId])
  @@index([reporterId])
}

model DirectMessage {
  id         String    @id @default(cuid())
  fromUserId String
  toUserId   String
  text       String    @default("")
  listingId  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  from    User           @relation("MessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to      User           @relation("MessageTo", fields: [toUserId], references: [id], onDelete: Cascade)
  listing MarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([toUserId, fromUserId])
  @@index([toUserId, readAt])
  @@index([listingId])
}

model WantRequest {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("WantRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  image       String
  budget      Int?
  budgetUnit  String?
  privacy     String   @default("ABC")
  city        String?
  area        String?
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  offers      WantOffer[]

  @@index([requesterId])
  @@index([hidden])
}

model WantOffer {
  id        String   @id @default(cuid())
  requestId String
  request   WantRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromId    String
  from      User        @relation("WantOfferer", fields: [fromId], references: [id], onDelete: Cascade)
  message   String
  price     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, fromId])
  @@index([requestId])
  @@index([fromId])
}

model Gathering {
  id          String   @id @default(cuid())
  hostId      String
  host        User     @relation("GatheringHost", fields: [hostId], references: [id], onDelete: Cascade)
  title       String
  description String
  kind        String
  image       String
  dateLabel   String
  timeLabel   String?
  location    String
  capacity    Int?
  privacy     String   @default("ABC")
  city        String?
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rsvps       GatheringRsvp[]

  @@index([hostId])
  @@index([hidden])
}

model GatheringRsvp {
  id        String    @id @default(cuid())
  eventId   String
  event     Gathering @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId  String
  person    User      @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([eventId, personId])
  @@index([eventId])
  @@index([personId])
}

model SavedListing {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

model ListingWatch {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("WatchOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  phrase       String?
  phraseNorm   String?
  targetUserId String?
  target       User?    @relation("WatchTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, kind])
  @@index([targetUserId, enabled])
  @@index([kind, enabled])
}

model SystemNotice {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  body          String
  actionHref    String?
  actionLabel   String?
  actorUserId   String?
  joinRequestId String?
  inviteId      String?
  listingId     String?
  watchId       String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, kind, actorUserId])
  @@index([userId, kind, watchId, createdAt])
}

model ThreadPreference {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("ThreadOwner", fields: [userId], references: [id], onDelete: Cascade)
  peerId    String
  peer      User      @relation("ThreadPeer", fields: [peerId], references: [id], onDelete: Cascade)
  archived  Boolean   @default(false)
  pinned    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, peerId])
  @@index([userId])
}

enum AdminRole {
  superadmin
  moderator
  support
  analyst
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         AdminRole
  lastLoginAt  DateTime?
  disabledAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]

  @@index([email])
  @@index([disabledAt])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  admin       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  reason      String?
  meta        Json?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
}

model AppSetting {
  id        String   @id
  flags     Json
  growth    Json
  auth      Json
  catalog   Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Broadcast {
  id          String   @id @default(cuid())
  title       String
  body        String
  actionHref  String?
  actionLabel String?
  audience    String
  sentCount   Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
