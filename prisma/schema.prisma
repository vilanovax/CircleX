generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrustGroup {
  A
  B
  C
}

enum RelationType {
  family
  friend
  colleague
  neighbor
  acquaintance
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum InviteKind {
  personal
  wave
}

enum JoinRequestStatus {
  pending
  accepted
  rejected
}

model User {
  id                 String    @id @default(cuid())
  phoneNormalized    String    @unique
  name               String    @default("")
  avatar             String    @default("")
  city               String?
  profileCompletedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions        Session[]
  otpChallenges   OtpChallenge[]
  invitesSent        Invite[]           @relation("Inviter")
  invitesAccepted    Invite[]           @relation("AcceptedBy")
  inviteAcceptances  InviteAcceptance[]
  inviteExpected     InviteExpected[]
  edgesFrom          CircleEdge[]       @relation("EdgeFrom")
  edgesTo            CircleEdge[]       @relation("EdgeTo")
  listings           MarketListing[]
  listingReports     ListingReport[]
  joinRequestsHost   CircleJoinRequest[] @relation("JoinHost")
  joinRequestsGuest  CircleJoinRequest[] @relation("JoinGuest")

  @@index([phoneNormalized])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpChallenge {
  id              String   @id @default(cuid())
  phoneNormalized String
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNormalized])
}

model Invite {
  id               String       @id @default(cuid())
  code             String       @unique
  inviterUserId    String
  inviter          User         @relation("Inviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitedPhone     String?
  invitedName      String?
  relationType     RelationType
  trustGroup       TrustGroup
  kind             InviteKind   @default(personal)
  maxUses          Int          @default(1)
  useCount         Int          @default(0)
  status           InviteStatus @default(pending)
  acceptedByUserId String?
  acceptedBy       User?        @relation("AcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  acceptances      InviteAcceptance[]
  expected         InviteExpected[]
  joinRequests     CircleJoinRequest[]

  @@index([inviterUserId, status])
  @@index([invitedPhone])
}

model InviteExpected {
  id           String   @id @default(cuid())
  inviteId     String
  phone        String
  name         String?
  joinedUserId String?
  createdAt    DateTime @default(now())
  invite       Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  joinedUser   User?    @relation(fields: [joinedUserId], references: [id], onDelete: SetNull)

  @@unique([inviteId, phone])
  @@index([inviteId])
  @@index([phone])
}

model InviteAcceptance {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String
  createdAt DateTime @default(now())
  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([inviteId])
  @@index([userId])
}

model CircleJoinRequest {
  id          String            @id @default(cuid())
  hostUserId  String
  guestUserId String
  inviteId    String?
  status      JoinRequestStatus @default(pending)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  host   User    @relation("JoinHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  guest  User    @relation("JoinGuest", fields: [guestUserId], references: [id], onDelete: Cascade)
  invite Invite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@unique([hostUserId, guestUserId])
  @@index([hostUserId, status])
  @@index([guestUserId])
  @@index([inviteId])
}

model CircleEdge {
  id           String       @id @default(cuid())
  fromUserId   String
  toUserId     String
  trustGroup   TrustGroup
  relationType RelationType
  displayName  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  from         User         @relation("EdgeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to           User         @relation("EdgeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model MarketListing {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        String
  price       Int?
  category    String
  image       String
  images      String[] @default([])
  condition   String?
  privacy     String   @default("ABC")
  city        String?
  specs       Json?
  dealStatus  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reports     ListingReport[]

  @@index([sellerId])
}

enum ListingReportReason {
  inappropriate
  misleading
  spam
  other
}

enum ListingReportStatus {
  open
  reviewed
  dismissed
}

model ListingReport {
  id         String              @id @default(cuid())
  listingId  String
  listing    MarketListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ListingReportReason
  note       String?
  status     ListingReportStatus @default(open)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
  @@index([listingId])
  @@index([reporterId])
}
