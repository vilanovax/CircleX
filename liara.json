{
  "app": "circle",
  "platform": "next",
  "port": 3000,
  "nodeVersion": "20",
  "node": {
    "version": "20",
    "mirror": true
  },
  "build": {
    "location": "iran",
    "command": "npx prisma generate && next build"
  },
  "start": {
    "command": "npx prisma migrate deploy && npx next start -p 3000"
  }
}
