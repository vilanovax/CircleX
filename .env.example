# Optional: enables OpenAI polish for listing title/description
# (never invents specs — only rewrites confirmed copy)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Postgres (Prisma). Keep the real URL in .env / .env.local — never commit it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/circle?schema=public"

# Signs session-cookie hashes. Use a long random string in .env.local.
SESSION_SECRET="change-me"

# Optional. Leave unset: HTTP localhost (even `next start`) keeps cookies;
# HTTPS (Liara) sets Secure. Set 1/0 only to force.
# COOKIE_SECURE=

# Dev OTP accepted by /api/auth/verify-otp until an SMS panel is wired.
OTP_DEV_CODE=12345

# Listing reports → platform admin
# Optional webhook (Slack/Discord/custom). Always logged server-side too.
# ADMIN_WEBHOOK_URL=https://hooks.example.com/...
# Bearer secret for GET /api/admin/listing-reports
# ADMIN_SECRET=change-me-admin

# First operator for /admin (used only by `npm run db:seed-admin`)
# ADMIN_EMAIL=ops@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=مدیر سیرکل

# User listing photos on disk (not in Postgres). On Liara, mount a persistent
# volume here — public/ is wiped on each deploy.
# UPLOAD_DIR=/data/uploads
