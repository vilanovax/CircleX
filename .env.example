# Optional: enables OpenAI polish for listing title/description
# (never invents specs — only rewrites confirmed copy)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Postgres (Prisma). Keep the real URL in .env / .env.local — never commit it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/circle?schema=public"

# Signs session-cookie hashes. Use a long random string in .env.local.
SESSION_SECRET="change-me"

# Dev OTP accepted by /api/auth/verify-otp until an SMS panel is wired.
OTP_DEV_CODE=12345
